# 1) Ensure Docker is running
sudo systemctl start docker

# 2) Allow GUI apps from the container (Gazebo/rviz)
xhost +local:docker



#  Add yourself to the docker group
sudo usermod -aG docker $USER


# Make the Docker socket owned by the docker group
sudo chgrp docker /var/run/docker.sock

# Apply the new group immediately (so you don’t have to reboot)
newgrp docker

# Test Docker access (should NOT need sudo)
docker ps


